{
  "name": "hands-agent",
  "displayName": "Hands [BETA]",
  "version": "1.4.1",
  "description": "Hands Agent - A Browsing Agent which can perform almost any browsinfg task ,",
  "author": "Hands Dev",
  "scripts": {
    "dev": "plasmo dev --no-cs-reload",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^3.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "manifest": {
    "name": "Hands [BETA]",
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "tabs",
      "activeTab",
      "history",
      "storage",
      "debugger",
      "scripting",
      "sidePanel",
      "alarms",
      "clipboardRead",
      "clipboardWrite",
      "downloads",
      "sessions",
      "topSites",
      "management",
      "cookies",
      "browsingData",
      "bookmarks",
      "declarativeNetRequest",
      "favicon",
      "identity"
    ],
    "oauth2": {
      "client_id": "937512875224-seerejuh2cdi4hbfvvn5coaoh7m6j65b.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ]
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "declarative_net_request": {
      "rule_resources": [
        {
          "id": "ruleset_1",
          "enabled": true,
          "path": "~assets/rules.json"
        }
      ]
    }
  }
}
